      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/sewer-cleaning.html",
      "destination": "/sewer-cleaning",
      "permanent": true
    },
    {
      "source": "/north-naples.html",
      "destination": "/north-naples",
      "permanent": true
    },
    {
      "source": "/old-naples.html",
      "destination": "/old-naples",
      "permanent": true
    },
    {
      "source": "/pelican-bay.html",
      "destination": "/pelican-bay",
      "permanent": true
    },
    {
      "source": "/park-shore-the-moorings.html",
      "destination": "/park-shore-the-moorings",
      "permanent": true
    },
    {
      "source": "/port-royal.html",
      "destination": "/port-royal",
      "permanent": true
    },
    {
      "source": "/shower-tub-drain-clog",
      "destination": "/sewer-cleaning",
      "permanent": true
    },
    {
      "source": "/pipe-blockage",
      "destination": "/clogged-drain-unclog",
      "permanent": true
    },
    {
      "source": "/drain-pipe-repair",
      "destination": "/drain-line-leak",
      "permanent": true
    },
    {
      "source": "/drain-cleaning-clogged-ground-drain",
      "destination": "/clogged-drain-unclog",
      "permanent": true
    },
    {
      "source": "/mainline-drain-cleaning",
      "destination": "/sewer-cleaning",
      "permanent": true
    },
    {
      "source": "/drain-cleaning-abc",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/commercial-drain-service",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/french-drain-service",
      "destination": "/services",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    },
    {
      "source": "/(about|blog|contact|locations|privacy-policy|services|sewer-cleaning|clogged-drain-unclog|drain-snaking-cabling|hydro-jetting|kitchen-sink-drain-clog|drain-line-leak|north-naples|old-naples|pelican-bay|park-shore-the-moorings|port-royal)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    },
    {
      "source": "/_drafts/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/_drafts/(.*)",
      "destination": "/404"
    }
  ]
}